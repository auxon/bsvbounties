{
  "name": "@ai-bounties/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:node": "tsc -p tsconfig.json && node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/stripe/*.test.ts"
  },
  "dependencies": {
    "@ai-bounties/contracts": "*",
    "@ai-bounties/llm": "*",
    "@ai-bounties/shared": "*",
    "@hono/node-server": "^1.14.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "hono": "^4.7.5",
    "stripe": "^22.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.0"
  }
}
